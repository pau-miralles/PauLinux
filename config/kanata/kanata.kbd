;; systemctl --user restart kanata.service
(defcfg
  linux-dev "/dev/input/by-path/platform-i8042-serio-0-event-kbd"
  process-unmapped-keys yes
  log-layer-changes no
)
(defsrc
  esc  tab  q    w    e    r    t    y    u    i    o    p    [    ]    bksl
       caps a    s    d    f    g    h    j    k    l    ;    '    ret
       lsft z    x    c    v    b    n    m    ,    .    /    rsft
       lctl lmet lalt           spc            ralt rctl
)

;; Base chords
(defchords base-chords 20
  (u) u
  (i) i
  (o) o
  (p) p
  (j) j
  (k) k
  (l) l
  (n) n
  (m) m
  (c) c
  (x) x
  (;) '
  (lsft) lsft
  (rsft) rsft
  (i o)    -
  (o p)    S-2
  (j k l)  (multi lctl c)
  (n m)    ;
  (c x)    \
  (l k)    S-3
  (u i)    S-'
  (u i o)  C-S-v
  (lsft rsft) caps
  (l ;)    [
)

;; Symbol chords
(defchords symbol-chords 20
  (d) S-8
  (f) S-9
  (d f) left
)

(defalias
  ;; Chords
  ch_u (chord base-chords u)
  ch_i (chord base-chords i)
  ch_o (chord base-chords o)
  ch_p (chord base-chords p)
  ch_j (chord base-chords j)
  ch_k (chord base-chords k)
  ch_l (chord base-chords l)
  ch_n (chord base-chords n)
  ch_m (chord base-chords m)
  ch_c (chord base-chords c)
  ch_x (chord base-chords x)
  ch_scl (chord base-chords ;)
  ch_ls (chord base-chords lsft)
  ch_rs (chord base-chords rsft)
  sym_d (chord symbol-chords d)
  sym_f (chord symbol-chords f)
  ;; Modifiers
  cec (tap-hold 150 150 esc lctl)
  altbck (tap-hold-press 150 150 bspc lalt)
  spn (tap-hold-release 200 200 spc (layer-toggle navigation))
  sym (layer-toggle symbols)
  bksl (multi ralt grv)
  ;; Symbol Macros
  at   (multi ralt 2)
  hash (multi ralt 3)
  eu   (multi ralt e)
  til  (multi ralt 4)
  pipe (multi ralt 1)
  lbra (multi ralt [)
  rbra (multi ralt ])
  lcur (multi ralt ')
  rcur (multi ralt \)
  neg  (multi ralt 6)
  cir  (macro S-[ spc)
  ;; Layers
  game (layer-switch game)
  base (layer-switch base)
)

(deflayer base
  caps _      _      _      _      _      _      _      @ch_u  @ch_i  @ch_o  @ch_p   del    _    /
       @cec   _      _      _      _      _      _      @ch_j  @ch_k  @ch_l  @ch_scl ret    rsft
       @ch_ls _      @ch_x  @ch_c  _      _      @ch_n  @ch_m  _      _      S-7     @ch_rs
       spc    _      @altbck              @spn          @sym   lsgt
)

(deflayer navigation
  _    f1   f2   f3   f4   f5   f6   home pgdn pgup end  _    _    _    _
       f7   f8   f9   f10  f11  f12  left down up   rght _    _    @game
       mute vold volu brdn brup _    _    _    _    _    _    _
       _    _    _              _              _    _
)

(deflayer symbols
  S-grv S-=   S--   @at   @lcur  @rcur   @pipe   S-0  4    5    6    kp*  _    _    _
        =     S-1   S-4   @sym_d  @sym_f @hash   0    1    2    3    @cir S-[  @base
        @bksl @til  S-6   @lbra   @rbra  S-5     .    7    8    9    _    _
        @eu   lsgt  S-lsgt               S-/                    _    _
)

(deflayer game
  caps _      _      _      _      _      _      _      @ch_u  @ch_i  @ch_o  @ch_p   del    _    /
       @cec   _      _      _      _      _      _      @ch_j  @ch_k  @ch_l  _       _      _
       @ch_ls _      @ch_x  @ch_c  _      _      @ch_n  @ch_m  _      _      S-7     @ch_rs
       _      _      @altbck              spc           @sym   lsgt

)
